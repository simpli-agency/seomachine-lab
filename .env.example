# SEO Machine Lab - shared credentials
# Copy to .env and fill in. Never commit .env.
#
# Per-project settings (domain, GSC property, competitors, market) do NOT go
# here - they live in projects/<slug>/project.json.

# ============================================
# DataForSEO (primary data source)
# ============================================
DATAFORSEO_LOGIN=your_email@example.com
DATAFORSEO_PASSWORD=your_api_password_here

# Optional: default market when a project config does not set one
# 2840 = USA, 2643 = Russia, 2276 = Germany - see DataForSEO location codes
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en

# ============================================
# Google Search Console (optional)
# ============================================
# Service account JSON with access to the GSC properties you research.
GSC_CREDENTIALS_PATH=./credentials/gsc-credentials.json

# Fallback property URL, used only when a project config has no gsc_site_url.
# GSC_SITE_URL=https://example.com/

# ============================================
# Google Analytics 4 (optional)
# ============================================
GA4_CREDENTIALS_PATH=./credentials/ga4-credentials.json
# GA4_PROPERTY_ID=123456789

# ============================================
# Defaults
# ============================================
# Project used when --project is omitted (defaults to _general).
# SEO_PROJECT=_general
